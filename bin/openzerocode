#!/usr/bin/env bun
// OpenZeroCode CLI entry point
//
// Works when installed globally via npm:
//   openzerocode
// Or via npx:
//   npx openzerocode
// Or directly:
//   ./bin/openzerocode

import { fileURLToPath } from "url"
import { dirname, resolve } from "path"
import { spawnSync } from "child_process"

const __dirname = dirname(fileURLToPath(import.meta.url))
const entry = resolve(__dirname, "..", "src", "client", "tui.tsx")
const preload = "@opentui/solid/preload"

// Re-spawn with preload if not already loaded
if (!process.env.OPENZEROCODE_LOADED) {
  const proc = spawnSync(
    process.argv[0], // "bun"
    ["run", "--preload", preload, entry, ...process.argv.slice(2)],
    { stdio: "inherit", env: { ...process.env, OPENZEROCODE_LOADED: "1" } },
  )
  process.exit(proc.status ?? 0)
}
