#!/usr/bin/env node
// OpenZeroCode CLI entry point
//
// Production (pre-built binary):
//   Looks for the standalone binary in dist/ or beside the script.
//   Spawns it via child_process. No bun required.
//
// Development (npm-install-from-git):
//   Falls back to running source via `bun run + preload`.

const childProcess = require("child_process")
const fs = require("fs")
const path = require("path")
const os = require("os")

// Read package.json for version info
let VERSION = "0.0.0-dev"
try {
  VERSION = require("../package.json").version || VERSION
} catch {}
const args = process.argv.slice(2)

// Handle --version / -v
if (args.includes("--version") || args.includes("-v")) {
  console.log(`openzerocode v${VERSION}`)
  process.exit(0)
}

// Handle --help / -h
if (args.includes("--help") || args.includes("-h")) {
  console.log(`openzerocode v${VERSION}`)
  console.log()
  console.log("Usage: openzerocode [options] [prompt...]")
  console.log()
  console.log("Options:")
  console.log("  -v, --version            Show version number")
  console.log("  -h, --help               Show this help message")
  console.log()
  process.exit(0)
}

const forwardedSignals = ["SIGINT", "SIGTERM", "SIGHUP"]

function run(target) {
  const child = childProcess.spawn(target, process.argv.slice(2), {
    stdio: "inherit",
  })

  child.on("error", (error) => {
    console.error(error.message)
    process.exit(1)
  })

  const forwarders = {}
  for (const signal of forwardedSignals) {
    forwarders[signal] = () => {
      try {
        child.kill(signal)
      } catch {
        // The child may have already exited.
      }
    }
    process.on(signal, forwarders[signal])
  }

  child.on("exit", (code, signal) => {
    for (const forwardedSignal of forwardedSignals) {
      process.removeListener(forwardedSignal, forwarders[forwardedSignal])
    }

    if (signal) {
      process.kill(process.pid, signal)
      return
    }

    process.exit(typeof code === "number" ? code : 0)
  })
}

const scriptPath = fs.realpathSync(__filename)
const scriptDir = path.dirname(scriptPath)
const rootDir = path.resolve(scriptDir, "..")

// Platform string mapping (matches opencode convention)
const PLATFORM_MAP = { darwin: "darwin", linux: "linux", win32: "windows" }
const ARCH_MAP = { x64: "x64", arm64: "arm64", arm: "arm" }
const platform = PLATFORM_MAP[os.platform()] || os.platform()
const arch = ARCH_MAP[os.arch()] || os.arch()
const binaryName = platform === "windows" ? "openzerocode.exe" : "openzerocode"

// Search order:
//   1) OPENZEROCODE_BIN env var
//   2) dist/openzerocode-<platform>-<arch>/bin/<binaryName>
//   3) dist/<binaryName>
//   4) node_modules/.bin/openzerocode (for global installs)
const candidates = []

if (process.env.OPENZEROCODE_BIN) {
  candidates.push(process.env.OPENZEROCODE_BIN)
}

// Platform-specific layout (created by scripts/build.ts)
candidates.push(
  path.resolve(rootDir, "dist", `openzerocode-${platform}-${arch}`, "bin", binaryName),
)

// Flat layout
candidates.push(path.resolve(rootDir, "dist", binaryName))

// Global install via npm: check node_modules/.bin
const moduleBin = path.resolve(rootDir, "node_modules", ".bin", binaryName)
candidates.push(moduleBin)

for (const candidate of candidates) {
  if (fs.existsSync(candidate)) {
    run(candidate)
    return // unreachable, but clarifies intent
  }
}

// Fallback: development mode — require bun
const bun = process.env.BUN || (process.platform === "win32" ? "bun.exe" : "bun")
const entry = path.resolve(rootDir, "src", "client", "tui.tsx")

if (!fs.existsSync(entry)) {
  console.error(
    "OpenZeroCode is not built yet. Run `npm run build` first, or install the release version.",
  )
  process.exit(1)
}

const preload = path.resolve(rootDir, "node_modules", "@opentui", "solid", "scripts", "preload.ts")
const devArgs = ["run"]
if (fs.existsSync(preload)) {
  devArgs.push("--preload", preload)
}
devArgs.push(entry, ...process.argv.slice(2))

const proc = childProcess.spawnSync(bun, devArgs, {
  stdio: "inherit",
  env: { ...process.env, NODE_ENV: process.env.NODE_ENV || "production" },
})
if (proc.error) {
  console.error(`OpenZeroCode requires \`bun\` to run from source.`)
  console.error(`Install bun: curl -fsSL https://bun.sh/install | bash`)
  console.error(`Or install the pre-built release: npm install -g openzerocode`)
  process.exit(1)
}
process.exit(proc.status ?? 0)
