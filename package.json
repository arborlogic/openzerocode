{
  "name": "openzerocode",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "AI coding assistant in the terminal",
  "bin": {
    "openzerocode": "bin/openzerocode"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "bun run --watch --preload @opentui/solid/preload src/client/tui.tsx",
    "start": "bun run --preload @opentui/solid/preload src/client/tui.tsx",
    "start:tui": "bun run --preload @opentui/solid/preload src/client/tui.tsx",
    "test": "tsx --test",
    "test:unit": "find src -name '*.test.ts' -not -path '*core/core.test.ts' -not -path '*provider/provider.test.ts' -print0 | xargs -0 tsx --test",
    "build": "bash scripts/build.sh"
  },
  "files": [
    "bin/openzerocode",
    "bin/package.json",
    "src/",
    "scripts/",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "@opentui/core": "^0.2.6",
    "@opentui/solid": "^0.2.6",
    "chalk": "^5.6.2",
    "effect": "4.0.0-beta.59",
    "marked": "^18.0.3",
    "solid-js": "^1.9.12",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
